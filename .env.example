# Settings for running Remidy in production with deploy/compose.yaml. `docker compose up` for development
# needs none of these. Copy this file to .env and replace the values. Never commit .env.

# Required. The database password. Generate a value with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me

# Required. The address people use to reach Remidy. Must use https in production.
PUBLIC_URL=https://remidy.example.com

# Required. Signs sessions. Generate a value with: openssl rand -base64 48
AUTH_SECRET=replace-me

# Required. Encrypts stored secrets. Generate a value with: openssl rand -base64 32
# Back this up separately from the database. Without it, those secrets can't be read.
ENCRYPTION_KEY=replace-me

# Optional, with their defaults. NODE_ENV is production unless you change it.
# The image version to run, such as 0.1.0-alpha.1. "alpha" is the newest alpha.
# REMIDY_VERSION=alpha
# NODE_ENV=production
# The port on this machine that your reverse proxy connects to.
# PORT=3000
# LOG_LEVEL=info
# The address of your reverse proxy, or several separated by commas, such as 172.18.0.0/16.
# Without it, rate limits treat everyone behind the proxy as a single visitor.
# TRUST_PROXY=
# ENABLED_FEATURES=first-feature,second-feature

# Needed for "Forgot your password?". Without these, the option isn't offered.
# SMTP_URL=smtp://user:password@mail.example.com:587
# EMAIL_FROM=Remidy <remidy@example.com>

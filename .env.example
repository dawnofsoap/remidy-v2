# Settings for running Remidy outside the development setup. `docker compose up` needs none of these.
# Copy this file to .env and replace the values. Never commit .env.

# Required. The server refuses to start with a guessable or missing password.
DATABASE_URL=postgresql://remidy:replace-me@localhost:5432/remidy

# Required. The address people use to reach Remidy. Must use https in production.
PUBLIC_URL=https://remidy.example.com

# Required. Signs sessions. Generate a value with: openssl rand -base64 48
AUTH_SECRET=replace-me

# Optional, with their defaults. NODE_ENV is production unless you change it.
# NODE_ENV=production
# PORT=3000
# LOG_LEVEL=info
# The address of your reverse proxy, or several separated by commas, such as 172.18.0.0/16.
# Without it, rate limits treat everyone behind the proxy as a single visitor.
# TRUST_PROXY=
# ENABLED_FEATURES=first-feature,second-feature
